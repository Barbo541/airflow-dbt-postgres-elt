# Local development template. Copy .env.example to .env and replace every
# replace_with_* placeholder. Keep .env untracked.
COMPOSE_PROJECT_NAME=dbt-pet-elt-local

# PostgreSQL cluster bootstrap role. This credential is used only by the DB
# container during initialization/health checks and is not passed to Airflow.
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=replace_with_a_local_admin_password
POSTGRES_HOST_PORT=5433

# Pet application/database runtime role used by Python ingestion and dbt.
PET_DB_USER=pet_app
PET_DB_PASSWORD=replace_with_a_local_app_password
PET_DB_NAME=pet_data

# Dedicated Airflow metadata role/database.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASS=replace_with_a_local_airflow_password
AIRFLOW_DB_NAME=airflow_db
AIRFLOW_HOST_PORT=8000

# Optional local image tag override.
AIRFLOW_IMAGE=dbt-pet-airflow:3.3.1
